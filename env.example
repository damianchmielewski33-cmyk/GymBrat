# Copy to .env.local and fill in values.
#
# | Zmienna | Wymagane | Opis |
# |---------|----------|------|
# | TURSO_DATABASE_URL | tak (produkcja) | URL bazy libSQL (lokalnie: `file:./local.db`) |
# | TURSO_AUTH_TOKEN | Turso cloud | Token REST; lokalnie pusty |
# | AUTH_SECRET | tak (produkcja) | Sekret NextAuth (np. 32 bajty base64) |
# | NEXTAUTH_URL | tak (produkcja) | Publiczny URL aplikacji (np. https://...) |
# | AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET | opcjonalnie | Logowanie / rejestracja kontem Google (OAuth) |
# | AUTH_FACEBOOK_ID / AUTH_FACEBOOK_SECRET | opcjonalnie | Logowanie / rejestracja kontem Facebook (OAuth) |
# | APP_ENCRYPTION_KEY | zalecane | AES-256 — zdjęcia raportów i inne pola wrażliwe w DB |
# | ADMIN_EMAILS | zalecane | CSV adresów z panelem admina (np. twoj@email.com) |
# | ADMIN_PIN | produkcja panelu | PIN do pierwszego wejścia w /admin |
# | UPSTASH_* | opcjonalnie | Redis — limit żądań rozproszony (więcej instancji) |
# | NEXT_PUBLIC_SENTRY_DSN / SENTRY_DSN | opcjonalnie | Błędy runtime |
# | NEXT_PUBLIC_POSTHOG_KEY | opcjonalnie | Analityka Community (PostHog project API key) |
# | POLLINATIONS_API_KEY | zalecane (grafiki diety) | Klucz sk_ z enter.pollinations.ai — grafiki przy imporcie JSON |
# | NEXT_PUBLIC_AWP_URL | opcjonalnie | URL Akademii Wielkich Piłkarzy (przejścia między serwisami) |
# | ANDROID_VERSION_JSON_URL / ANDROID_APK_URL | opcjonalnie | Źródło wersji APK dla /api/android/version |
# | JAVA_API_BASE_URL | opcjonalnie | URL Spring Boot (`java-backend`) — BFF proxy |
# | GYMBRAT_PROXY_TOKEN | z Java API | Wspólny sekret BFF → Java (`X-GymBrat-Proxy-Token`) |
# | HOTPAY_SEKRET | pakiety | Sekret serwisu bramki płatniczej |
# | HOTPAY_NOTIFICATION_PASSWORD | pakiety | Hasło hash notyfikacji płatności |
# | HOTPAY_PAYMENT_URL | opcjonalnie | URL bramki płatniczej |
# | LEGAL_SELLER_NAME / ADDRESS / NIP… | legal | Dane sprzedawcy w /regulamin |
# | LEGAL_CONTACT_EMAIL / PHONE | legal | Obsługa klienta w regulaminie |
# | NEXT_PUBLIC_ADMOB_INTERSTITIAL_ID | opcjonalnie | ID jednostki interstitial (web fallback / info) |
# |


# Turso / libsql (Vercel: set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN)
# Lokalnie: ścieżka względem katalogu projektu (npm run dev / db:push)
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# NextAuth — wymagane w produkcji; lokalnie możesz wygenerować:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))  # PowerShell
#   openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Community realtime: `poll` (domyślnie — krótkie HTTP, bezpieczne na Hobby/Free)
# albo `sse` (dłuższe połączenia; tylko gdy masz zapas CPU, np. Vercel Pro).
NEXT_PUBLIC_COMMUNITY_REALTIME=poll

# Logowanie Google (OAuth 2.0) — Google Cloud Console → Credentials → OAuth client (Web).
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://TWOJA-DOMENA/api/auth/callback/google
# Bez obu zmiennych przycisk Google jest wyłączony.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Logowanie Facebook (OAuth) — Meta for Developers → App → Facebook Login → Settings.
# Valid OAuth Redirect URIs:
#   http://localhost:3000/api/auth/callback/facebook
#   https://TWOJA-DOMENA/api/auth/callback/facebook
# App ID → AUTH_FACEBOOK_ID, App Secret → AUTH_FACEBOOK_SECRET.
# Bez obu zmiennych przycisk Facebook jest wyłączony.
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Bramka płatnicza — pakiety GymBrat (Pay-by-Link).
# Panel operatora → serwis → Ustawienia:
#   Adres notyfikacji: https://TWOJA-DOMENA/api/payments/hotpay/notify
#   SEKRET serwisu → HOTPAY_SEKRET
#   Hasło hash notyfikacji → HOTPAY_NOTIFICATION_PASSWORD
HOTPAY_SEKRET=
HOTPAY_NOTIFICATION_PASSWORD=
# HOTPAY_PAYMENT_URL=

# Dane sprzedawcy w /regulamin i /polityka-prywatnosci.
# Link do wklejenia: https://TWOJA-DOMENA/regulamin
# Polityka: https://TWOJA-DOMENA/polityka-prywatnosci
LEGAL_SELLER_NAME=
LEGAL_SELLER_ADDRESS=
# LEGAL_SELLER_NIP=
# LEGAL_SELLER_REGON=
# LEGAL_SELLER_KRS=
LEGAL_CONTACT_EMAIL=support@gymbrat.app
LEGAL_CONTACT_PHONE=

# AdMob (web info / APK: local.properties admob.app.id + admob.interstitial.unit.id)
# NEXT_PUBLIC_ADMOB_INTERSTITIAL_ID=

# Szyfrowanie pól w DB (zdjęcia raportów itd.) — klucz AES-256: 32 bajty jako base64 lub hex.
# Wygeneruj: Node: require('crypto').randomBytes(32).toString('base64')
APP_ENCRYPTION_KEY=

# Admin panel: PIN wymagany na produkcji (ustaw w środowisku).
ADMIN_PIN=

# Adresy email kont administratorów (CSV, bez spacji — dopasowanie case-insensitive).
# Po pierwszym logowaniu rola `admin` jest zapisywana w bazie.
# Przykład: ADMIN_EMAILS=jan@firma.pl,twoj@gmail.com
ADMIN_EMAILS=

# Jednorazowy token POST /api/admin/bootstrap (CSRF + sesja) — gdy w bazie nie ma jeszcze admina.
ADMIN_BOOTSTRAP_TOKEN=

# Cron / maintenance: sekret do wywołania sprzątania bazy (GET/POST /api/cron/cleanup).
# Vercel Cron (vercel.json → 03:00 UTC) wysyła Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Rate limiting rozproszony (Upstash Redis REST) — opcjonalnie; bez tego limit jest in-process.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Limity storage Turso (MB). Soft = blokada nowych zdjęć; hard = emergency purge w cronie.
TURSO_STORAGE_SOFT_LIMIT_MB=700
TURSO_STORAGE_HARD_LIMIT_MB=850

# Retencja danych (dni) – chroni darmowy limit Turso (bez kasowania treningów/posiłków/kont).
RETENTION_PAGE_VIEWS_DAYS=21
RETENTION_ACTIVITY_LOG_DAYS=45
RETENTION_ADMIN_AUDIT_DAYS=180
RETENTION_EMAIL_CODES_DAYS=14
# Zdjęcia użytkowników (raporty ciała, media feedu, bug reporty) NIGDY nie są usuwane przez cleanup.
RETENTION_TEAM_FEED_EVENTS_DAYS=7
RETENTION_NOTIFICATION_EVENTS_DAYS=7
RETENTION_NOTIFICATIONS_READ_DAYS=60
RETENTION_NOTIFICATIONS_MAX_DAYS=180
RETENTION_CHAT_MESSAGES_DAYS=90
RETENTION_CHAT_EVENTS_DAYS=7
RETENTION_CHAT_TYPING_DAYS=2
RETENTION_FRIEND_LIVE_PRESENCE_DAYS=2
RETENTION_ACTIVE_WORKOUT_SESSIONS_DAYS=7

# --- Email: weryfikacja rejestracji (Nodemailer + SMTP) ---
# Użyj konta Gmail lub Outlook (Microsoft) albo innego dostawcy SMTP.
#
# Gmail:
#   1) Włącz weryfikację dwuetapową na koncie Google.
#   2) Wygeneruj „Hasło do aplikacji” (App password): Google Account → Security → App passwords.
#   3) SMTP_USER = pełny adres Gmail, SMTP_PASS = wygenerowane hasło aplikacji (nie zwykłe hasło).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# Outlook.com / Hotmail (osobiste konto Microsoft):
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   Czasem wymagane jest hasło aplikacji jeśli masz MFA — Microsoft Account → Security.
#
# Microsoft 365 / Outlook firmowy (często):
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# EMAIL_FROM — opcjonalnie; jeśli puste, jako nadawca używany jest SMTP_USER.
# Format: "GymBrat <twoj@email.com>" lub sam adres.
# EMAIL_REPLY_TO — opcjonalny adres „odpowiedz do”.
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Sekret do hashowania kodów (możesz użyć osobnego od AUTH_SECRET):
EMAIL_CODE_SECRET=

# Ten sam kalendarz co wpisy posiłków / Start (domyślnie Europa/Warszawa).
# Ustaw obie zmienne na produkcji, żeby serwer i przeglądarka liczyły ten sam „dzisiaj”.
# CALENDAR_TIMEZONE=Europe/Warsaw
# NEXT_PUBLIC_CALENDAR_TIMEZONE=Europe/Warsaw

# PostHog — Community product analytics (opcjonalnie; bez klucza eventy są no-op)
# Project API Key z PostHog → Project Settings. Host EU domyślnie.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Alias serwerowy (opcjonalnie): POSTHOG_API_KEY= / POSTHOG_HOST=

# Sentry (opcjonalnie — błędy runtime)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Opcjonalnie: release po stronie klienta (np. ten sam co deploy)
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_SENTRY_RELEASE=gymbrat@0.1.0
# SENTRY_ENVIRONMENT=production

# Jedyny zewnętrzny AI: grafiki przepisów (Pollinations). Brak Gemini/Ollama/ai-server.
# Legacy image.pollinations.ai zwraca 402 — aplikacja woła gen.pollinations.ai.
# Klucz: https://enter.pollinations.ai → sk_… (tylko serwer, NIE NEXT_PUBLIC_).
# POLLINATIONS_API_KEY=
# Alias: POLLINATIONS_KEY=

# Siostrzana aplikacja Akademia Wielkich Piłkarzy (przejścia header/login/stopka).
# Domyślnie: https://akademia-wielkich-pilkarzy.vercel.app
# NEXT_PUBLIC_AWP_URL=https://akademia-wielkich-pilkarzy.vercel.app

# Aplikacja Android GymBrat (publiczny GET /api/android/version — bez logowania).
# Tylko to repozytorium. Nie ustawiaj tu release'u Akademii — APK AWP psuje popup aktualizacji.
# ANDROID_VERSION_JSON_URL=https://github.com/damianchmielewski33-cmyk/GymBrat/releases/download/android-latest/android-version.json
# Źródło APK przy buildzie Vercel (fetch → public/gymbrat.apk). Runtime CTA = /gymbrat.apk.
# ANDROID_APK_URL=https://github.com/damianchmielewski33-cmyk/GymBrat/releases/download/android-latest/gymbrat.apk
# NEXT_PUBLIC_ANDROID_APK_URL=
#
# Backend Java (Spring Boot w java-backend/). Gdy ustawione, Next proxy’uje wybrane /api/*.
# JAVA_API_BASE_URL=http://localhost:8080
# GYMBRAT_PROXY_TOKEN=dev-shared-token
#
# Dieta — wyszukiwanie produktów: Open Food Facts (bez klucza) + USDA FoodData Central.
# Bez klucza używany jest DEMO_KEY (limit zapytań). Własny klucz: https://fdc.nal.usda.gov/api-key-signup.html
# USDA_FDC_API_KEY=
#
# Changelog i GET /api/version zawsze opisują wdrożenie z repozytorium GymBrat
# (damianchmielewski33-cmyk/GymBrat). Nie ustawiaj tu obcego źródła wersji.
