{
  "title": "GymBrat — ekrany Analiza postępów (co jest wyświetlane)",
  "version": "2.0",
  "date": "2026-10-23",
  "purpose": "Inwentarz UI sekcji Analiza: układ, zakładki, bloki. Formuły i eligibility → docs/progress-training-analysis.json. Silniki Intelligence → docs/analytics-intelligence.json.",
  "designPrinciples": [
    "Jedna informacja = jedno miejsce. Wartość pokazana w Przeglądzie nie jest powtarzana w zakładce (tam są szczegóły).",
    "Jedna sekcja = jedna karta (ProgressSection + Surface); bez numeracji 01/A/C.",
    "Objaśnienia metodologii pod ikoną „i” (Explainer), nie stopki pod każdą kartą.",
    "Długie listy i dodatki są zwijane (CollapsibleCard) z jednozdaniowym podsumowaniem w nagłówku.",
    "Wspólne klocki: components/progress/progress-ui.tsx; formattery: lib/progress-format.ts."
  ],
  "route": "/progress",
  "legacyRedirect": {
    "from": "/progress-analysis",
    "to": "/progress (lub /progress?tab=… / /progress/exercises/…)"
  },
  "pageShell": {
    "file": "app/(dashboard)/progress/page.tsx",
    "title": "Analiza postępów",
    "kicker": "OD {dzień} {MIESIĄC_PL} · {N} TRENING / TRENINGI / TRENINGÓW (strength.sinceDate + workoutCount)",
    "tabsNav": {
      "component": "components/progress/progress-tabs.tsx",
      "queryParam": "tab",
      "default": "przeglad (bez parametru w URL)",
      "tabs": [
        { "id": "przeglad", "label": "Przegląd" },
        { "id": "sila", "label": "Siła" },
        { "id": "sylwetka", "label": "Sylwetka" },
        { "id": "tydzien", "label": "Tygodnie" }
      ],
      "legacyAliases": { "zdjecia": "sylwetka" }
    },
    "errorState": {
      "title": "Nie udało się wczytać analizy",
      "cta": "Odśwież analizę → /progress?tab={active}"
    },
    "dataLoader": "lib/progress-hub.ts → getProgressHubData"
  },
  "screens": [
    {
      "id": "przeglad",
      "label": "Przegląd",
      "component": "components/progress/overview-tab.tsx",
      "question": "Jak jest teraz i dokąd to zmierza?",
      "blocks": [
        {
          "id": "readiness",
          "component": "readiness-card.tsx",
          "shows": ["zmęczenie 0–100 + miernik + Δ tydzień", "regeneracja % + miernik", "rekomendacja", "do 3 wskazówek coacha"]
        },
        {
          "id": "thisWeek",
          "component": "week-progress-calendar-card.tsx",
          "shows": ["zakres tygodnia, dni do końca", "wykonane / cel treningów", "dni (trening/cardio)", "tonaż vs poprzedni tydzień", "cardio min vs cel", "seria tygodni"]
        },
        {
          "id": "trends",
          "title": "Trendy · ostatnie 30 dni",
          "shows": ["e1RM %", "tonaż %", "waga od startu", "regularność 30 dni"],
          "interaction": "kafelek przenosi do zakładki ze szczegółami (Siła / Sylwetka / Tygodnie)"
        },
        { "id": "goals", "title": "Następne cele", "shows": ["paski postępu celów"] },
        { "id": "achievements", "title": "Zdobyte", "shows": ["3 ostatnie, „Pokaż wszystkie”"] }
      ]
    },
    {
      "id": "sila",
      "label": "Siła",
      "component": "components/progress/strength-tab.tsx",
      "question": "Czy robię się silniejszy i gdzie jest problem?",
      "blocks": [
        {
          "id": "trend",
          "title": "Trend siły",
          "component": "strength-trend-card.tsx (StrengthTrendCard)",
          "shows": ["przełącznik 7/30/90 dni", "e1RM % i tonaż %", "najszybciej rośnie / spada (top 3)", "partie — objętość (top 4, rozwijane)"],
          "replaces": ["licznik rośnie/stoi/spada", "Tempo zmian", "Najszybciej rośnie / spada"]
        },
        {
          "id": "exercises",
          "title": "Ćwiczenia wg planu",
          "shows": ["liczniki ↑ → ↓ w nagłówku", "plany zwijane (pierwszy otwarty)", "wiersz: nazwa, zmiana vs poprzedni trening, wartość, sparkline"],
          "link": "/progress/exercises/{name}"
        },
        { "id": "records", "title": "Rekordy", "collapsed": true, "shows": ["e1RM / max powtórzeń, badge „nowy”"] },
        { "id": "intensity", "title": "Intensywność", "shows": ["RIR, RPE, twarde serie", "zgodność z planem", "tempo i definicje w „i”"] },
        { "id": "balance", "title": "Balans mięśniowy", "component": "muscle-balance-panel.tsx", "shows": ["udział partii (30 dni) z paskami", "alert nierównowagi", "stagnacja (top 3)"] },
        { "id": "forecast", "title": "Prognoza e1RM", "component": "strength-trend-card.tsx (StrengthForecastCard)", "collapsed": true, "shows": ["średnia 30/90 dni", "top 5 ćwiczeń z pewnością"] }
      ]
    },
    {
      "id": "sylwetka",
      "label": "Sylwetka",
      "component": "components/progress/body-tab.tsx (+ photos-tab.tsx → PhotoCompareSection)",
      "question": "Jak zmienia się moje ciało?",
      "blocks": [
        { "id": "weight", "shows": ["ostatnia waga, Δ od startu (+ start)", "wykres wagi ze średnią", "cel wagi + szacowany termin (edycja inline)"] },
        { "id": "tempo", "title": "Tempo", "shows": ["kg/tydz. 6 tygodni", "kg/tydz. od startu", "zmiana vs poprzedni raport"] },
        { "id": "measures", "title": "Obwody", "shows": ["pas, udo, klatka, ramię: wartość, Δ od startu, sparkline"] },
        { "id": "photos", "title": "Zdjęcia · Start i Teraz", "shows": ["jeden suwak porównania z etykietami dat", "Δ waga i pas między zdjęciami", "zmiana zdjęcia startowego / wybór z raportów"], "empty": "Dodaj co najmniej dwa zdjęcia… → /reports?new=1" }
      ]
    },
    {
      "id": "tydzien",
      "label": "Tygodnie",
      "component": "components/progress/week-tab.tsx",
      "question": "Jak wyglądały ostatnie tygodnie?",
      "blocks": [
        { "id": "compare", "component": "week-over-week-card.tsx", "shows": ["wybór tygodnia A i B", "metryki z deltą i werdyktem"] },
        { "id": "last8", "title": "Ostatnie 8 tygodni", "component": "week-bar-chart.tsx", "shows": ["treningi / tonaż / cardio"] },
        { "id": "dietTraining", "title": "Dieta a trening", "shows": ["bieżący tydzień: kcal i białko vs cel", "lista tygodni (4, rozwijane do 8)"] },
        { "id": "cardio", "title": "Cardio", "shows": ["obciążenie, kcal tygodnia", "minuty w strefach Z1–Z5", "werdykt wydolności"] },
        { "id": "adherence", "title": "Realizacja i regularność", "shows": ["łącznie / trening / dieta / cardio %", "regularność: tydzień, 30 dni, 90 dni"] }
      ]
    }
  ],
  "emptyAndGateStates": [
    { "where": "Siła / rekordy", "when": "brak zaliczonych serii", "copy": "Zaliczone serie… pojawią się tu jako rekordy." },
    { "where": "Siła / plan", "when": "planGroups.length === 0", "copy": "Ustaw plan treningowy albo zalicz pierwsze serie." },
    { "where": "Siła / prognoza", "when": "brak predykcji", "copy": "Prognoza e1RM pojawi się po kilku tygodniach treningu…" },
    { "where": "Sylwetka / waga", "when": "brak raportów", "copy": "Brak raportów wagi — dodaj pierwszy w Raportach." },
    { "where": "Sylwetka / obwody", "when": "wszystkie currentCm null", "copy": "Dodaj obwody w raporcie…" },
    { "where": "Sylwetka / zdjęcia", "when": "!canCompare", "copy": "Dodaj co najmniej dwa zdjęcia…" },
    { "where": "Tygodnie / dieta", "when": "!dietTraining.hasGoals", "copy": "Ustaw cele kcal/makro w Profilu…" },
    { "where": "Przegląd / osiągnięcia", "when": "unlocked.length === 0", "copy": "Trenuj dalej — osiągnięcia odblokują się automatycznie." },
    { "where": "Detal ćwiczenia / wykres", "when": "< 2 punkty", "copy": "Potrzeba co najmniej dwóch treningów do wykresu." }
  ],
  "navigationMap": [
    { "from": "Siła · wiersz ćwiczenia / rekord / lider trendu", "to": "/progress/exercises/{name}" },
    { "from": "Detal ćwiczenia · wstecz", "to": "/progress?tab=sila" },
    { "from": "Sylwetka · brak porównania zdjęć", "to": "/reports?new=1" },
    { "from": "Przegląd · kafelki trendów", "to": "zakładki Siła / Sylwetka / Tygodnie (stan lokalny + ?tab=)" },
    { "from": "zakładki", "to": "/progress?tab=sila|sylwetka|tydzien (przegląd = /progress)" }
  ],
  "sourceOfTruthUi": [
    "app/(dashboard)/progress/page.tsx",
    "components/progress/progress-page-content.tsx",
    "components/progress/progress-hub-view.tsx",
    "components/progress/progress-tabs.tsx",
    "components/progress/progress-ui.tsx",
    "components/progress/overview-tab.tsx",
    "components/progress/readiness-card.tsx",
    "components/progress/strength-tab.tsx",
    "components/progress/strength-trend-card.tsx",
    "components/progress/muscle-balance-panel.tsx",
    "components/progress/body-tab.tsx",
    "components/progress/photos-tab.tsx",
    "components/progress/week-tab.tsx",
    "components/progress/week-progress-calendar-card.tsx",
    "components/progress/week-over-week-card.tsx",
    "components/progress/week-bar-chart.tsx",
    "components/progress/weight-average-chart.tsx",
    "components/progress/exercise-detail-view.tsx",
    "components/progress/exercise-period-compare-panel.tsx",
    "lib/progress-tabs.ts",
    "lib/progress-format.ts",
    "lib/progress-hub.ts"
  ],
  "relatedDocs": [
    "docs/progress-training-analysis.json — formuły, eligibility, okna danych",
    "docs/analytics-intelligence.json — silniki Fatigue/Recovery/Muscle/Cardio 2.0",
    "docs/extra-cardio-from-macros.json — cardio przy nadwyżce (wpływ na minuty)"
  ]
}
