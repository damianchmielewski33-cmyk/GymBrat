{
  "title": "GymBrat — podpowiedzi podczas treningu (live set coach)",
  "version": "3.0",
  "date": "2026-10-16",
  "purpose": "Lokalne, deterministyczne rady jak dobry trener siłowy: trend > event, readiness/confidence, e1RM, fatigue, profile ruchu, anomalie danych. Double progression bez easy_anywhere. Bez LLM.",
  "philosophy": [
    "Nigdy zbyt agresywne +kg ani paniczny deload po jednym słabym dniu",
    "Nie nagradzaj jednego dobrego dnia — wymagaj trendu (trailing easy / e1RM)",
    "Pojedyncza seria nie dominuje decyzji",
    "Słabe dane → niższe confidence, tip zawsze widoczny"
  ],
  "sourceOfTruth": [
    "lib/set-effort.ts",
    "lib/exercise-movement-kind.ts",
    "lib/set-progression-suggestion.ts",
    "lib/live-set-coach.ts",
    "lib/last-workout-hints.ts",
    "lib/live-coach/*.ts"
  ],
  "tests": [
    "lib/live-coach/live-coach-engines.test.ts",
    "lib/live-set-coach.test.ts",
    "lib/set-progression-suggestion.test.ts",
    "lib/training-feature-pack.test.ts",
    "lib/exercise-movement-kind.test.ts"
  ],
  "engines": {
    "readiness": {
      "module": "lib/live-coach/readiness.ts",
      "range": "0–100",
      "bands": {
        "90+": "progress_ready",
        "70-89": "normal",
        "50-69": "conservative",
        "30-49": "hold",
        "0-29": "deload_consider"
      },
      "factors": [
        "lastRir",
        "rirTrend",
        "volumeTrend",
        "e1rmTrend",
        "hardStreak",
        "warnStreak",
        "layoff",
        "stagnant",
        "sessionFatigue",
        "prs",
        "hr"
      ]
    },
    "confidence": {
      "module": "lib/live-coach/confidence.ts",
      "range": "0–100",
      "rule": "Nigdy nie ukrywa rekomendacji — tylko obniża score",
      "factors": [
        "historyCount",
        "conflict",
        "missingData",
        "suspicious",
        "layoff",
        "e1rmStability",
        "volumeConsistency",
        "fatigue",
        "hr"
      ]
    },
    "e1rm": {
      "module": "lib/live-coach/e1rm-trend.ts",
      "formula": "Epley: w*(1+r/30)",
      "stores": ["last", "avg", "best", "trend4"],
      "rule": "ciężar↑ reps↓ ale e1RM↑ = progres; wyklucza stagnację"
    },
    "fatigue": {
      "module": "lib/live-coach/fatigue.ts",
      "range": "0–100",
      "effect": "obniża confidence/readiness — nie wymusza deloadu"
    },
    "restAwareness": {
      "module": "lib/live-coach/rest-awareness.ts",
      "buckets": {
        "<60s": "fatigueDropSensitivity≈0.35 — ignoruj mały repsDrop",
        "90-180s": "normal (=1)",
        ">240s": "oczekuj lepszego utrzymania reps (sens≈1.15)"
      },
      "wiring": "active-workout-view persistRestSecondsFromTimer → set.restSeconds"
    },
    "movementProfiles": {
      "module": "lib/live-coach/movement-profiles.ts",
      "examples": {
        "Deadlift": "RIR 2–3",
        "Squat": "RIR 1–2",
        "Bench": "RIR 1",
        "Machine Press": "RIR 1",
        "Biceps Curl": "RIR 0–1",
        "Calves": "RIR 0"
      },
      "priority": "plan.targetRir > profil nazwy/kategorii"
    },
    "suspicious": {
      "module": "lib/live-coach/suspicious-data.ts",
      "flags": [
        "PR kg + PR reps + RIR4+",
        "RPE10 + RIR4+",
        "skok kg/e1RM ≥15%",
        "konflikt RIR/RPE"
      ],
      "effect": "suspicious=true + confidencePenalty; tip nadal widoczny"
    },
    "stagnation2": {
      "module": "lib/last-workout-hints.ts → isStagnantV2",
      "requiresAll": [
        "≥3 sesje",
        "brak wzrostu kg",
        "brak wzrostu reps",
        "brak wzrostu e1RM",
        "średni RIR ≤1"
      ]
    },
    "progressionBumps": {
      "module": "lib/live-coach/progression-bumps.ts",
      "kinds": {
        "aggressive": "readiness≥95 ∧ confidence≥90 → compound +5 / iso +2.5",
        "normal": "+2.5",
        "minimum": "conservative lub confidence<55 → compound +2.5 / iso +1.25",
        "hold": "readiness <50 lub !allowWeightBump"
      },
      "respects": "double progression (najpierw reps)"
    },
    "personalRecords": {
      "module": "lib/live-coach/personal-records.ts",
      "types": ["weight", "reps", "volume", "e1rm"],
      "effect": "bonus readiness; NIE auto +kg"
    },
    "hr": {
      "module": "lib/live-coach/hr-signals.ts",
      "fields": ["heartRate", "restingHR", "recoveryHR"],
      "rule": "tylko soft ± readiness/confidence; nigdy sam deload"
    }
  },
  "uiSurfaces": [
    {
      "id": "live_banner",
      "component": "components/active-workout/live-coach-banner.tsx",
      "shows": ["decision", "body/highlight", "reason", "Readiness", "Confidence", "dane niepewne"]
    },
    {
      "id": "rest_card",
      "component": "components/active-workout/rest-break-screen.tsx",
      "builder": "buildLiveCoachTipAfterCompletedSet → liveCoachTipToPlainText"
    },
    {
      "id": "suggestion_chip",
      "builder": "mergeHintsIntoExercises → suggestWeightFromLastSet"
    }
  ],
  "tipSchema": {
    "id": "string",
    "tone": "progress|caution|hold|info",
    "body": "string",
    "prefix": "string",
    "highlight": "string|null",
    "suffix": "string",
    "apply": "{ weightKg, reps } | null",
    "decision": "string — np. Dodaj 2,5 kg",
    "reason": "string — najważniejszy powód",
    "readiness": "0–100",
    "confidence": "0–100",
    "suspicious": "boolean?",
    "bumpKind": "minimum|normal|aggressive|hold|deload?"
  },
  "invariants": [
    "Deterministyczne warianty tekstu: FNV-1a seed",
    "RIR > RPE; konflikt → hold",
    "Bez easy_anywhere",
    "+kg dopiero po N easy na górze (compound 2 / isolation 3)",
    "Trend-over-event: jedna hard przy e1RM↑ → hold-form, nie deload",
    "Tip.apply tylko po stuknięciu użytkownika",
    "Ciężar z historii startuje od 0 do kliknięcia chipa"
  ],
  "decisionTreeOpenSet": {
    "entry": "buildLiveCoachTipForOpenSet → buildCoachSignals → drzewo v2 + modulacja readiness",
    "priority": "sesja > layoff/stagnacja/historia > plan > warmup",
    "modulation": [
      "softPedal deload gdy e1RM↑ i hardStreak<2",
      "readiness hold/deload_consider blokuje bump",
      "plateStep z resolveProgressionBump"
    ]
  },
  "dataInputs": {
    "WorkoutSetState": ["weight", "reps", "rir", "rpe", "restSeconds?", "heartRate?"],
    "ExerciseCoachContext": [
      "daysSinceLastSession",
      "recentSessionCount",
      "avgTopSetWeightKg",
      "stagnant",
      "e1rm?",
      "recentSessions?",
      "prs?",
      "restingHR?",
      "recoveryHR?"
    ]
  },
  "edgeCases": [
    "Jedna hard seria + rosnący e1RM → session-hold-form (nie deload)",
    "Jedna easy na górze → hold",
    "RIR/RPE conflict → tip hold + niskie confidence",
    "PR + RIR4 + skok 15% → suspicious, bez auto +kg",
    "Layoff ≥14 → readiness↓, hist-layoff",
    "Stagnacja bez spadku e1RM → false",
    "rest <60s + repsDrop=2 → ignore fatigue drop",
    "Brak historii → niski confidence, tip plan-range/warmup widoczny",
    "Isolation vs compound: easyNeeded i bump step różne"
  ],
  "potentialRegressions": [
    "Tip IDs i tony v2 (progress/caution/hold/info)",
    "Chip suggestWeightFromLastSet bez auto-wpisu",
    "Testy v2: +2.5 po 2 easy, hold po 1 easy, layoff 95 kg",
    "mergeHintsIntoExercises — ciężar startuje od 0",
    "pickCoachVariant determinizm",
    "liveCoachTipToPlainText teraz wieloliniowy (decision+scores)"
  ],
  "examples": [
    {
      "scenario": "2× łatwa 36×10 RIR3 w sesji",
      "expectedTipId": "session-bump",
      "apply": { "weightKg": 38.5, "reps": 8 },
      "decision": "Dodaj 2,5 kg"
    },
    {
      "scenario": "1× hard + e1RM trend up",
      "expectedTipId": "session-hold-form",
      "why": "trend-over-event"
    },
    {
      "scenario": "RIR5 + RPE10",
      "expectedTipId": "session-conflict-hold",
      "suspicious": true
    }
  ],
  "nonGoals": [
    "Brak LLM w ścieżce live tip",
    "Brak pełnego UI tętna w v3 (pola opcjonalne)",
    "Brak auto-zmiany ciężaru bez gestu użytkownika"
  ]
}
