# Skopiuj do deploy/.env na VPS (NIGDY do gita).
# Pełna lista zmiennych aplikacji: ../env.example
# Docs: docs/deployment.md, docs/staging.md

# --- Host / proxy ---
# Publiczny host bez https:// (staging najpierw!)
GYMBRAT_DOMAIN=staging.example.com
CADDY_ACME_EMAIL=admin@example.com

# Obraz z GHCR (tag semver przy rollbacku — docs/rollback.md)
GYMBRAT_IMAGE=ghcr.io/damianchmielewski33-cmyk/gymbrat:latest

# --- Single Source of Truth URL (WWW; APK dopiero po GO-LIVE) ---
NEXTAUTH_URL=https://staging.example.com
NEXT_PUBLIC_APP_URL=https://staging.example.com

# --- Wymagane ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=
CRON_SECRET=

# --- Zalecane ---
ADMIN_EMAILS=
ADMIN_PIN=
APP_ENCRYPTION_KEY=

# OAuth (redirect URI = https://<domena>/api/auth/callback/...)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=

# SMTP (opcjonalnie na staging)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Cron: domyślnie raz na dobę; reminders nadal przez GitHub Actions
# CRON_INTERVAL_SEC=86400
# CRON_TARGET_URL=http://gymbrat-web:3000/api/cron/cleanup
