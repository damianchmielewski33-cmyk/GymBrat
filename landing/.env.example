# Adres landingu (kanoniczny, sitemap). Domena zostanie uzupełniona po zakupie: [DOMENA].
PUBLIC_SITE_URL=https://example.com
# Adres aplikacji (app.[DOMENA]): formularz powiadomień, logowanie, regulamin. Lokalnie: http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# Opcjonalnie: film w hero (MP4 w public/, np. /hero.mp4) i plakat (np. /hero-poster.webp). Bez nich działa animowana scenka.
PUBLIC_HERO_VIDEO=
PUBLIC_HERO_POSTER=
