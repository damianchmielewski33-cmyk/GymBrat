{
  "name": "gymbrat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "kill-port 3000 3001 && next dev",
    "build": "node scripts/fetch-android-apk.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:ci": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy:check": "node scripts/check-gymbrat-deploy.mjs",
    "deploy:check:production": "node scripts/check-gymbrat-deploy.mjs --quality --production",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "photos:migrate-storage": "node --experimental-strip-types --no-warnings scripts/migrate-photos-to-storage.ts",
    "perf:budget": "node scripts/perf-budget.mjs",
    "db:migrate:run": "node scripts/db-migrate.mjs",
    "db:migrate:check": "node scripts/db-migrate.mjs --check",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node scripts/db-reset.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.5",
    "@libsql/client": "^0.18.0",
    "@sentry/nextjs": "^11.11.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.37.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "framer-motion": "^14.11.1",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0",
    "web-push": "^4.0.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.3.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "kill-port": "^2.0.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
